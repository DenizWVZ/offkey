{
  "name": "offkey",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit",
    "build:demo": "node scripts/fetch-model.mjs && vite build --config vite.demo.config.ts",
    "build:ext": "node scripts/build-extension.mjs",
    "build:ext:dev": "node scripts/build-extension.mjs --dev",
    "dev:ext": "node scripts/build-extension.mjs --watch",
    "preview": "vite preview",
    "check": "node --experimental-websocket --no-warnings scripts/check-playback.mjs",
    "check:ext": "node scripts/check-extension.mjs",
    "icons": "node --experimental-websocket --no-warnings scripts/make-icons.mjs",
    "postinstall": "node scripts/patch-signalsmith.mjs"
  },
  "dependencies": {
    "dialkit": "^2.0.2",
    "motion": "^13.4.4",
    "onnxruntime-web": "^1.30.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "signalsmith-stretch": "^1.3.2"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.1"
  }
}
